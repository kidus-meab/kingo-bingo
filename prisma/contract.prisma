// use prisma-8

model User {
  id          String   @id
  telegramId  String   @unique
  firstName   String
  username    String?
  photoUrl    String?
  balance     Int      @default(1000)
  createdAt   DateTime @default(now())
  hostedRooms Room[]   @relation("RoomHost")
  playerCards PlayerCard[]
  wins        Win[]
  deposits    Deposit[]
  sentTransfers     Transfer[] @relation("TransferFrom")
  receivedTransfers Transfer[] @relation("TransferTo")
}

model Room {
  id         String   @id
  code       String   @unique
  status     String
  stake      Int      @default(10)
  createdAt  DateTime @default(now())
  hostUserId String?
  host       User?    @relation("RoomHost", fields: [hostUserId], references: [id])
  rounds     Round[]
}

model Round {
  id             String         @id
  roomId         String
  room           Room           @relation(fields: [roomId], references: [id])
  status         String
  pattern        String
  hopInEndsAt    DateTime?
  startingEndsAt DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  playerCards    PlayerCard[]
  calledNumbers  CalledNumber[]
  wins           Win[]
}

model Cartela {
  id          String       @id
  index       Int          @unique
  cells       String
  playerCards PlayerCard[]
}

model PlayerCard {
  id           String  @id
  roundId      String
  userId       String
  cartelaId    String
  marks        String  @default("[]")
  disqualified Int     @default(0)
  stakePaid    Int     @default(0)
  round        Round   @relation(fields: [roundId], references: [id])
  user         User    @relation(fields: [userId], references: [id])
  cartela      Cartela @relation(fields: [cartelaId], references: [id])
  wins         Win[]

  @@unique([roundId, userId])
  @@unique([roundId, cartelaId])
}

model CalledNumber {
  id       String   @id
  roundId  String
  value    Int
  order    Int
  calledAt DateTime @default(now())
  round    Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, value])
}

model Win {
  id           String     @id
  roundId      String
  userId       String
  playerCardId String
  pattern      String
  payout       Int        @default(0)
  claimedAt    DateTime   @default(now())
  round        Round      @relation(fields: [roundId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  playerCard   PlayerCard @relation(fields: [playerCardId], references: [id])
}

model DepositAccount {
  id            String    @id
  label         String
  bankName      String
  accountName   String
  accountNumber String
  active        Int       @default(1)
  sortOrder     Int       @default(0)
  deposits      Deposit[]
}

model Deposit {
  id         String         @id
  userId     String
  accountId  String
  amount     Int
  smsText    String
  status     String
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id])
  account    DepositAccount @relation(fields: [accountId], references: [id])
}

model Transfer {
  id         String   @id
  fromUserId String
  toUserId   String
  amount     Int
  createdAt  DateTime @default(now())
  fromUser   User     @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("TransferTo", fields: [toUserId], references: [id])
}
