BOT_ACCESS_TOKEN=

DATABASE_URL=file:./prisma/kingo.db

# Optional: only needed when running the standalone Hono process (`bun server/index.ts`).
# Normal `bun run dev` serves /api through Next.js + Hono.
API_PORT=4000

# =============================================================================
# Kingo config — set KINGO_* (server) and/or NEXT_PUBLIC_KINGO_* (client).
# Lookup checks NEXT_PUBLIC_ first, then KINGO_.
# =============================================================================

# --- Game timing (milliseconds) ---
KINGO_AUTO_DRAW_MS=6000
KINGO_HOP_IN_MS=30000
KINGO_STARTING_MS=5000
KINGO_WINNER_MS=5000
# KINGO_CO_WIN_MS=0

# --- Client polling (milliseconds) ---
# Use NEXT_PUBLIC_ so the play screen can read these in the browser.
NEXT_PUBLIC_KINGO_LOBBY_POLL_MS=2000
NEXT_PUBLIC_KINGO_LIVE_POLL_MS=1000

# --- Bingo board / cartelas ---
KINGO_BALL_MIN=1
KINGO_BALL_MAX=75
KINGO_CARTELA_COUNT=100
KINGO_CARTELA_SEED=20260922

# --- Room defaults ---
NEXT_PUBLIC_KINGO_ROOM_CODE=KINGO
KINGO_ROUND_PATTERN=any_line

# --- Economy (Birr) ---
KINGO_STAKE_BIRR=10
KINGO_BALANCE_BIRR=1000
FIRST_REWARD=100
KINGO_MIN_DEPOSIT_BIRR=10
KINGO_MIN_TRANSFER_BIRR=1

# --- Deposit accounts (JSON array). Leave unset for built-in CBE + Telebirr. ---
# KINGO_DEPOSIT_ACCOUNTS=[{"label":"CBE","bankName":"Commercial Bank of Ethiopia","accountName":"Kingo Bingo","accountNumber":"1000123456789","active":1,"sortOrder":1}]
